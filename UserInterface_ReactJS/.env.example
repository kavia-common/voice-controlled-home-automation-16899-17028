# Base URL for the backend serving the User Interface API (e.g., http://localhost:8000 or a gateway path)
REACT_APP_API_BASE_URL=http://localhost:8000

# Optional API key header if your backend requires it (not mandated by the UI OpenAPI)
REACT_APP_API_KEY=

# Polling interval in ms for device status auto-refresh (used in Status page)
REACT_APP_STATUS_POLL_INTERVAL=5000
